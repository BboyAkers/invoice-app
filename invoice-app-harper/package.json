{
  "name": "invoice-app-harper",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "agent:run": "npx -y @harperfast/agent@latest",
    "agent:skills:update": "npx -y skills@latest add harperfast/skills --all --yes",
    "start": "harper run .",
    "dev": "harper dev .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test test/*.test.ts",
    "test:watch": "node --watch --test test/*.test.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "harper deploy by_ref=true credential=true restart=true replicated=true",
    "deploy:setup": "harper deploy setup=true"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@harperfast/schema-codegen": "^2.0.0",
    "@harperfast/vite": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/router-devtools": "^1.167.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
